{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client", "node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": { "vitest": ["./node_modules/vitest"], "rhino3dm": ["./node_modules/rhino3dm"] }
  },
  "include": ["engine", "ui", "api", "brief", "sites", "scripts", "vite.config.ts", "../test"]
}
